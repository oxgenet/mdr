<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain framework widgets on the DeviceDefault theme: the app ships no UI
  library, which is deliberate for a reader whose pitch is a fast, small
  binary. Section headings use the system accent so the screen still reads as
  native in both light and dark mode.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="32dp">

        <!-- Reading -->
        <TextView
            style="@style/SectionHeading"
            android:text="@string/section_reading" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/toc_label"
                    style="@style/PrefTitle"
                    android:text="@string/pref_toc" />

                <TextView
                    style="@style/PrefSummary"
                    android:text="@string/pref_toc_summary" />
            </LinearLayout>

            <Switch
                android:id="@+id/toc_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:contentDescription="@string/pref_toc" />
        </LinearLayout>

        <TextView
            style="@style/PrefTitle"
            android:layout_marginTop="20dp"
            android:text="@string/pref_lang" />

        <TextView
            style="@style/PrefSummary"
            android:text="@string/pref_lang_summary" />

        <Spinner
            android:id="@+id/lang_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/pref_lang" />

        <View style="@style/Divider" />

        <!-- Support the developer -->
        <TextView
            style="@style/SectionHeading"
            android:text="@string/section_support" />

        <TextView
            style="@style/PrefSummary"
            android:text="@string/support_blurb" />

        <!-- Swapped for the tier buttons once Play returns the catalogue. -->
        <TextView
            android:id="@+id/support_status"
            style="@style/PrefSummary"
            android:layout_marginTop="16dp"
            android:text="@string/support_loading" />

        <LinearLayout
            android:id="@+id/tier_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <View style="@style/Divider" />

        <!-- About -->
        <TextView
            style="@style/SectionHeading"
            android:text="@string/section_about" />

        <TextView
            android:id="@+id/about_version"
            style="@style/PrefTitle" />

        <TextView
            style="@style/PrefSummary"
            android:text="@string/about_blurb" />

        <!-- Both notices are required: MIT obliges a derivative to carry the
             original copyright, and the desktop and iOS About screens show the
             same pair. -->
        <TextView
            android:id="@+id/about_copyright"
            style="@style/PrefSummary"
            android:layout_marginTop="10dp"
            android:text="@string/about_copyright" />

        <TextView
            android:id="@+id/about_upstream"
            style="@style/PrefSummary"
            android:text="@string/about_upstream" />
    </LinearLayout>
</ScrollView>
